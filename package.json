{
  "name": "recommendation-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for RD Station Product Recommendation System",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start --workspace=backend",
    "start": "lerna run start",
    "start:frontend": "npm run dev --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "build": "lerna run build",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "lerna run test",
    "test:frontend": "npm run test --workspace=frontend",
    "test:coverage": "npm run test:coverage --workspace=frontend",
    "lint": "lerna run lint",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:fix": "npm run lint:fix --workspace=frontend",
    "clean": "lerna clean -y && rm -rf node_modules",
    "clean:install": "npm run clean && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "lerna": "^8.0.2"
  },
  "engines": {
    "node": ">=18.3.0",
    "npm": ">=9.0.0"
  }
}
